local function updateHUD()
    local wmOn  = WmCfg["Enabled"]
    local aimOn = CameraCfg["Enabled"] and isLocking
    local saOn  = SilentCfg["Enabled"]
    local tbOn  = TriggerCfg["Enabled"] and triggerEnabled

    if not wmOn then
        for _, d in pairs(hud) do d.Visible = false end
        return
    end

    local vp      = Camera.ViewportSize
    local cx      = vp.X / 2
    local rowH    = 16
    local anchorY = vp.Y - 170

    hud.brand.Visible   = true
    hud.brand.Size      = 16
    hud.brand.Text      = "Oprial"
    hud.brand.Color     = Color3.fromRGB(255,255,255)
    hud.brand.Position  = Vector2.new(cx, anchorY)

    local activeTarget = silentTarget or currentTarget
    local targetName = ""
    if saOn and activeTarget and activeTarget.Parent then
        local p = Players:GetPlayerFromCharacter(activeTarget.Parent)
        if p then targetName = " (" .. p.Name .. ")" end
    end

    hud.aimbot.Text     = "Aimbot"
    hud.aimbot.Color    = aimOn and PURPLE or GREY
    hud.aimbot.Visible  = true
    hud.aimbot.Position = Vector2.new(cx, anchorY + rowH * 1)

    hud.silent.Text     = "Silent Aim" .. targetName
    hud.silent.Color    = saOn and PURPLE or GREY
    hud.silent.Visible  = true
    hud.silent.Position = Vector2.new(cx, anchorY + rowH * 2)

    hud.trigger.Text     = "Trigger Bot"
    hud.trigger.Color    = tbOn and PURPLE or GREY
    hud.trigger.Visible  = true
    hud.trigger.Position = Vector2.new(cx, anchorY + rowH * 3)

    hud.speed.Text      = "WalkSpeed"
    hud.speed.Color     = SpeedEnabled and PURPLE or GREY
    hud.speed.Visible   = true
    hud.speed.Position  = Vector2.new(cx, anchorY + rowH * 4)
end

local function elasticOut(t)
    local p=0.3
    return math.pow(2,-10*t)*math.sin((t-p/4)*(2*math.pi)/p)+1
end
local function sineInOut(t) return -(math.cos(math.pi*t)-1)/2 end

local function isPlayerKnockedOrKO(player)
    local chk = GlobalCfg["Check"]["Whilst a player is selected"]
    if not chk["Knocked"] then return false end
    if player.Character then
        local be=player.Character:FindFirstChild("BodyEffects")
        if be then
            local ko=be:FindFirstChild("K.O")     if ko and ko.Value then return true end
            local kn=be:FindFirstChild("Knocked") if kn and kn.Value then return true end
        end
    end
    return false
end

local function isSelfKnocked()
    if not GlobalCfg["Check"]["Whilst a player is selected"]["Self-Knocked"] then return false end
    if LocalPlayer.Character then
        local be=LocalPlayer.Character:FindFirstChild("BodyEffects")
        if be then
            local ko=be:FindFirstChild("K.O")     if ko and ko.Value then return true end
            local kn=be:FindFirstChild("Knocked") if kn and kn.Value then return true end
        end
    end
    return false
end

local function canSeeTarget(part)
    if not GlobalCfg["Check"]["Whilst a player is selected"]["Visible"] then return true end
    if not part or not part.Parent then return false end
    local character=part.Parent
    local origin=Camera.CFrame.Position
    local direction=(part.Position-origin).Unit*(part.Position-origin).Magnitude
    local rp=RaycastParams.new()
    rp.FilterDescendantsInstances={LocalPlayer.Character,character,outlinePart}
    rp.FilterType=Enum.RaycastFilterType.Exclude rp.IgnoreWater=true
    local res=Workspace:Raycast(origin,direction,rp)
    return res==nil or res.Instance:IsDescendantOf(character)
end

local function canSelectPlayer(player)
    local chk=GlobalCfg["Check"]["When selecting a player"]
    if chk["Knocked"] and isPlayerKnockedOrKO(player) then return false end
    return true
end

