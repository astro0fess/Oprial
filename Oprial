local function isMouseInCameraFOV()
    if not CameraCfg["FOV"]["Enabled"] then return true end
    if not currentTarget or not currentTarget.Parent then return false end
    local hrp=currentTarget.Parent:FindFirstChild("HumanoidRootPart") if not hrp then return false end
    local sp,on=Camera:WorldToViewportPoint(hrp.Position)
    if not on or sp.Z<=0 then return false end
    local sc=Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local fov=CameraCfg["FOV"]["Size"]
    local rx=fov["X"]*Camera.ViewportSize.X/100
    local ry=fov["Y"]*Camera.ViewportSize.Y/100
    local dx=math.abs(sp.X-sc.X) local dy=math.abs(sp.Y-sc.Y)
    return dx<=rx and dy<=ry
end

local function findClosestTarget()
    local closest,shortestDist=nil,math.huge
    local mp=UserInputService:GetMouseLocation()
    for _,player in pairs(Players:GetPlayers()) do
        if player~=LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            if canSelectPlayer(player) then
                for _,part in pairs(getBodyParts(player.Character)) do
                    if part and canSeeTarget(part) then
                        local sp,on=Camera:WorldToViewportPoint(part.Position)
                        if on then
                            local d=math.sqrt((sp.X-mp.X)^2+(sp.Y-mp.Y)^2)
                            if d<shortestDist then shortestDist=d closest=part end
                        end
                    end
                end
            end
        end
    end
    return closest
end

local function getPredictedPosition(part, predTable)
    local vel=part.AssemblyLinearVelocity
    local px = predTable["X"] or 0
    local py = predTable["Y"] or 0
    local pz = predTable["Z"] or 0
    if px==0 and py==0 and pz==0 then return part.Position end
    return part.Position + Vector3.new(vel.X*px, vel.Y*py, vel.Z*pz)
end

local function getAimPart(character)
    local hitPart=CameraCfg["Hit Part"]
    if hitPart=="Closest Part" then
        local sc=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y/2)
        local best,bestD=nil,math.huge
        for _,part in pairs(getBodyParts(character)) do
            if part then
                local sp,on=Camera:WorldToViewportPoint(part.Position)
                if on then
                    local d=(Vector2.new(sp.X,sp.Y)-sc).Magnitude
                    if d<bestD then bestD=d best=part end
                end
            end
        end
        return best or character:FindFirstChild("HumanoidRootPart")
    else
        return character:FindFirstChild(hitPart) or character:FindFirstChild("HumanoidRootPart")
    end
end

local function getTargetForCameraLock()
    if not isLocking then return nil end
    -- if we have a locked target, keep tracking it
    if currentTarget and currentTarget.Parent then
        local player=Players:GetPlayerFromCharacter(currentTarget.Parent)
        if player and not isPlayerKnockedOrKO(player) then
            return getAimPart(currentTarget.Parent)
        else
            currentTarget=nil isLocking=false lastVisibleTarget=nil return nil
        end
    end
    -- no target yet, find closest to cursor
    local part=findClosestTarget()
    if part and part.Parent then
        currentTarget=part
        lastVisibleTarget=part
        return getAimPart(part.Parent)
    end
    return nil
end

local function applyCameraLock()
    if not CameraCfg["Enabled"] or not isLocking then return end
    if isSelfKnocked() then
        currentTarget=nil isLocking=false lastVisibleTarget=nil targetLine.Visible=false return
    end
    local target=getTargetForCameraLock()
    if not target then return end
    local targetPos=getPredictedPosition(target, CameraCfg["Prediction"])
    local cc=Camera.CFrame
    local tc=CFrame.new(cc.Position,targetPos)
    local snap=math.clamp(CameraCfg["Snappiness"],0.001,1)
    Camera.CFrame=cc:Lerp(tc,snap)
end

local function updateTargetLine()
    if not currentTarget or not currentTarget.Parent or not isLocking then targetLine.Visible=false return end
    local hrp=currentTarget.Parent:FindFirstChild("HumanoidRootPart")
    if not hrp then targetLine.Visible=false return end
    local sp,on=Camera:WorldToViewportPoint(hrp.Position)
    if on and sp.Z>0 then
        local mp=UserInputService:GetMouseLocation()
        targetLine.From=Vector2.new(mp.X,mp.Y) targetLine.To=Vector2.new(sp.X,sp.Y)
        targetLine.Color=canSeeTarget(currentTarget) and Color3.fromRGB(0,255,0) or Color3.fromRGB(255,0,0)
        targetLine.Visible=false  -- set to true below if you want the target line visible
    else targetLine.Visible=false end
end

local function TriggerBot()
    if not TriggerCfg["Enabled"] then return end
    if not triggerEnabled then return end
    if tick()-lastTriggerClick < TriggerCfg["Click Cooldown"] then return end
    local weapons=TriggerCfg["Weapons"]
    if #weapons > 0 then
        local tool=LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if not tool then return end
        local valid=false
        for _,wn in pairs(weapons) do if tool.Name==wn then valid=true break end end
        if not valid then return end
    end
    local tbTarget = currentTarget or silentTarget
    if not tbTarget then tbTarget = findClosestTarget() end
    if not tbTarget then return end
    local character=tbTarget.Parent if not character then return end
    local player=Players:GetPlayerFromCharacter(character) if not player then return end
    if isPlayerKnockedOrKO(player) then return end
    mouse1click()
    lastTriggerClick=tick()
end

local grm=getrawmetatable(game)
local oldIndex=grm.__index
setreadonly(grm,false)

grm.__index=function(self,key)
    if not checkcaller() and self==Mouse and SilentCfg["Enabled"] then
        if key=="Hit" then
            local character

            -- prefer camera lock target when active
            if isLocking and currentTarget and currentTarget.Parent then
                character=currentTarget.Parent
            else
                -- find closest to cursor independently
                local mp=UserInputService:GetMouseLocation()
                local bestPart,bestDist=nil,math.huge
                for _,player in pairs(Players:GetPlayers()) do
                    if player~=LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                        if not isPlayerKnockedOrKO(player) then
                            for _,part in pairs(getBodyParts(player.Character)) do
                                if part then
                                    local sp,on=Camera:WorldToViewportPoint(part.Position)
                                    if on then
                                        local d=(Vector2.new(sp.X,sp.Y)-mp).Magnitude
                                        if d<bestDist then bestDist=d bestPart=part end
                                    end
                                end
                            end
                        end
                    end
                end
                if not bestPart then return oldIndex(self,key) end
                silentTarget=bestPart
                character=bestPart.Parent
            end

            if not character then return oldIndex(self,key) end
            local player=Players:GetPlayerFromCharacter(character)
            if not player or isPlayerKnockedOrKO(player) then return oldIndex(self,key) end

            local hitPart=SilentCfg["Hit Part"]
            local targetPart
            if hitPart=="Closest Part" or hitPart=="Closest Point" then
                local mp=UserInputService:GetMouseLocation()
                local best,bestD=nil,math.huge
                for _,part in pairs(getBodyParts(character)) do
                    if part then
                        local sp,on=Camera:WorldToViewportPoint(part.Position)
                        if on then
                            local d=(Vector2.new(sp.X,sp.Y)-mp).Magnitude
                            if d<bestD then bestD=d best=part end
                        end
                    end
                end
                targetPart=best or character:FindFirstChild("HumanoidRootPart")
            else
                targetPart=character:FindFirstChild(hitPart) or character:FindFirstChild("HumanoidRootPart")
            end
            if not targetPart then return oldIndex(self,key) end
            silentTarget=targetPart
            return CFrame.new(getPredictedPosition(targetPart, SilentCfg["Prediction"]))
        end
    end
    return oldIndex(self,key)
end

setreadonly(grm,true)
trackHook(function() setreadonly(grm,false) grm.__index=oldIndex setreadonly(grm,true) end)

local oldRandom
oldRandom=hookfunction(math.random,function(...)
    local args={...}
    if checkcaller() then return oldRandom(...) end
    if (#args==0) or (args[1]==-0.05 and args[2]==0.05) or args[1]==-0.1 or args[1]==-0.05 then
        if SpreadCfg["Enabled"] then
            local tool=LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
            if tool then
                local entry=SpreadCfg[tool.Name]
                if entry then
                    return oldRandom(...) * entry.Multiplier
                end
            end
        end
    end
    return oldRandom(...)
end)
trackHook(function() hookfunction(math.random,oldRandom) end)

local function btpCFrameOffset(origin, target)
    local actual=origin*CFrame.new(0,-1,0, 1,0,0, 0,0,1, 0,-1,0)
    return actual:ToObjectSpace(target):Inverse()
end

local btpToolData={}

local function teardownBTPTool(tool)
    local data=btpToolData[tool] if not data then return end
    if data.activated then data.activated:Disconnect() end
    btpToolData[tool]=nil
end

local function doFireBTP(tool)
    if not BTPCfg["Enabled"] then return end
    if not btpEnabled then return end
    local weapons=BTPCfg["Weapons"]
    if #weapons > 0 then
        local ok=false
        for _,wn in pairs(weapons) do if tool.Name==wn then ok=true break end end
        if not ok then return end
    end
    if not currentTarget then return end
    local char=currentTarget.Parent if not char then return end
    local player=Players:GetPlayerFromCharacter(char)
    if not player or isPlayerKnockedOrKO(player) then return end

    local partName=BTPCfg["Part"] or "Head"
    local targetPart=char:FindFirstChild(partName)
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("HumanoidRootPart")
    if not targetPart then return end

    local myChar=LocalPlayer.Character if not myChar then return end
    local rhand=myChar:FindFirstChild("RightHand") if not rhand then return end

    local origGrip=tool.Grip
    task.spawn(function()
        tool.Parent=LocalPlayer.Backpack
        tool.Grip=btpCFrameOffset(rhand.CFrame,targetPart.CFrame)
        tool.Parent=myChar
        RunService.RenderStepped:Wait()
        tool.Parent=LocalPlayer.Backpack
        tool.Grip=origGrip
        tool.Parent=myChar
    end)
end

local function setupBTPTool(tool)
    if not tool:IsA("Tool") then return end
    if btpToolData[tool] then return end
    local data={}
    btpToolData[tool]=data
    data.activated=tool.Activated:Connect(function() doFireBTP(tool) end)
end

local function handleCharBTP(char)
    if not char then return end
    for _,v in ipairs(char:GetChildren()) do if v:IsA("Tool") then setupBTPTool(v) end end
    trackConnection(char.ChildAdded:Connect(function(v)   if v:IsA("Tool") then setupBTPTool(v)   end end))
    trackConnection(char.ChildRemoved:Connect(function(v) if v:IsA("Tool") then teardownBTPTool(v) end end))
end

local function handleBackpackBTP(bp)
    for _,v in ipairs(bp:GetChildren()) do if v:IsA("Tool") then setupBTPTool(v) end end
    trackConnection(bp.ChildAdded:Connect(function(v) if v:IsA("Tool") then setupBTPTool(v) end end))
end

task.spawn(function()
    local char=LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    handleCharBTP(char)
    handleBackpackBTP(LocalPlayer:WaitForChild("Backpack"))
end)

trackConnection(LocalPlayer.CharacterAdded:Connect(function(char)
    for tool in pairs(btpToolData) do teardownBTPTool(tool) end
    task.wait(0.1) handleCharBTP(char)
end))

local function getHealthColor(pct)
    pct=math.clamp(pct,0,1)
    if pct>0.6 then local t=(pct-0.6)/0.4 return Color3.fromRGB(math.floor(255*(1-t)),255,0)
    elseif pct>0.3 then local t=(pct-0.3)/0.3 return Color3.fromRGB(255,math.floor(180*t+75),0)
    else return Color3.fromRGB(255,math.floor(75*(pct/0.3)),0) end
end

local function isKnockedESP(player)
    if not player.Character then return false end
    local be=player.Character:FindFirstChild("BodyEffects") if not be then return false end
    local ko=be:FindFirstChild("K.O")     if ko and ko.Value then return true end
    local kn=be:FindFirstChild("Knocked") if kn and kn.Value then return true end
    return false
end

local function getHeldWeapon(player)
    if not player.Character then return nil end
    local t=player.Character:FindFirstChildOfClass("Tool")
    return t and t.Name:gsub("%[",""):gsub("%]","") or nil
end

