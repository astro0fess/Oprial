local function addESPToPlayer(player)
    if player==LocalPlayer then return end
    if espLabels[player.UserId] then
        local old=espLabels[player.UserId]
        for _,v in pairs(old) do if typeof(v)=="userdata" then pcall(function() v:Remove() end) end end
        espLabels[player.UserId]=nil
    end
    local t=trackDrawing(Drawing.new("Text"))
    t.Font=Drawing.Fonts.UI t.Size=13 t.Bold=true t.Center=true
    t.Outline=true t.OutlineColor=Color3.fromRGB(0,0,0)
    t.Color=Color3.fromRGB(180,0,255) t.Visible=false t.ZIndex=1004
    local e={ player=player, nameTag=t }
    espLabels[player.UserId]=e
end

local function removeESPFromPlayer(player)
    local uid = typeof(player)=="Instance" and player.UserId or (player and player.UserId)
    if not uid then return end
    local e=espLabels[uid] if not e then return end
    for _,v in pairs(e) do
        if typeof(v)=="userdata" then
            pcall(function() v.Visible=false end)
            pcall(function() v:Remove() end)
        end
    end
    espLabels[uid]=nil espHealthSmooth[uid]=nil
    if currentTarget and player and typeof(player)=="Instance" then
        local char=player.Character
        if char and currentTarget.Parent==char then
            currentTarget=nil isLocking=false lastVisibleTarget=nil targetLine.Visible=false
        end
    end
end

local function hideESP(e)
    e.nameTag.Visible=false
end

local function refreshESP()
    if not espEnabled then
        for _,e in pairs(espLabels) do hideESP(e) end return
    end
    for userId,e in pairs(espLabels) do
        local player=e.player
        if not player or not player.Parent then removeESPFromPlayer(player or {UserId=userId}) continue end
        local char=player.Character
        if not(char and char.Parent and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Head")) then hideESP(e) continue end
        local hum=char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health<=0 then hideESP(e) continue end
        local feetSP,feetOn=Camera:WorldToViewportPoint(char.HumanoidRootPart.Position-Vector3.new(0,3,0))
        local headSP,headOn=Camera:WorldToViewportPoint(char.Head.Position)
        if not feetOn or not headOn or feetSP.Z<=0 then hideESP(e) continue end
        local dname=ESPCfg["Use Display Name"] and player.DisplayName or player.Name
        e.nameTag.Text=dname
        e.nameTag.Color=Color3.fromRGB(180,0,255)
        e.nameTag.Position=Vector2.new(feetSP.X, feetSP.Y+4)
        e.nameTag.Visible=true
    end
end

for _,player in pairs(Players:GetPlayers()) do
    if player~=LocalPlayer then addESPToPlayer(player) end
    trackConnection(player.CharacterAdded:Connect(function(char)
        removeESPFromPlayer(player) char:WaitForChild("HumanoidRootPart") task.wait(0.1) addESPToPlayer(player)
    end))
    trackConnection(player.CharacterRemoving:Connect(function() removeESPFromPlayer(player) end))
end
trackConnection(Players.PlayerAdded:Connect(function(player)
    if player==LocalPlayer then return end
    addESPToPlayer(player)
    trackConnection(player.CharacterAdded:Connect(function(char)
        removeESPFromPlayer(player) char:WaitForChild("HumanoidRootPart") task.wait(0.1) addESPToPlayer(player)
    end))
    trackConnection(player.CharacterRemoving:Connect(function() removeESPFromPlayer(player) end))
end))
trackConnection(Players.PlayerRemoving:Connect(removeESPFromPlayer))

trackConnection(RunService.RenderStepped:Connect(function()
    if isSelfKnocked() and isLocking then
        currentTarget=nil isLocking=false lastVisibleTarget=nil targetLine.Visible=false
    end

    TriggerBot()

    if SpeedEnabled and SpeedCfg["Enabled"] then
        local hum=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        if hum then
            local ts = SpeedCfg["Speed"] or 35
            if hum.WalkSpeed~=ts then hum.WalkSpeed=ts end
        end
        if SpeedCfg["Anti Fling"] then
            local hrp=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local vel=hrp.Velocity
                if vel.Y>50 or vel.Y<-50 then hrp.Velocity=Vector3.new(vel.X,0,vel.Z) end
            end
        end
    end

    if SlowCfg["Enabled"] and not SpeedEnabled then
        local hum=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        local tool=LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if hum and tool then
            local entry=SlowCfg["Weapons"][tool.Name]
            if entry then
                local target=16*entry.Multiplier
                if hum.WalkSpeed~=target then hum.WalkSpeed=target end
            else
                if hum.WalkSpeed~=16 then hum.WalkSpeed=16 end
            end
        end
    end

    updateTargetLine()
    refreshESP()
    applyCameraLock()
    updateHUD()
end))

trackConnection(UserInputService.InputBegan:Connect(function(input,processed)
    if processed then return end
    local kc=input.KeyCode

    -- camera aimbot keybind
    if kc==Enum.KeyCode[CameraCfg["Keybind"]] then
        local mode=CameraCfg["Keybind Mode"]
        if mode=="Toggle" then
            if GlobalCfg["Target Aim"] then
                if isLocking then
                    isLocking=false currentTarget=nil lastVisibleTarget=nil targetLine.Visible=false
                else
                    local target=findClosestTarget()
                    if target then currentTarget=target lastVisibleTarget=target isLocking=true end
                end
            else
                isLocking=not isLocking
                if not isLocking then targetLine.Visible=false end
            end
        elseif mode=="Hold" then
            if GlobalCfg["Target Aim"] then
                local target=findClosestTarget()
                if target then currentTarget=target lastVisibleTarget=target isLocking=true end
            else isLocking=true end
        end
    end

    -- silent aim keybind
    if kc==Enum.KeyCode[SilentCfg["Keybind"]] then
        local mode=SilentCfg["Keybind Mode"]
        if mode=="Toggle" then
            SilentCfg["Enabled"]=not SilentCfg["Enabled"]
        elseif mode=="Hold" then
            SilentCfg["Enabled"]=true
        end
    end

    local tbMode=TriggerCfg["Activation"]["Activation Mode"]
    local tbKey =TriggerCfg["Activation"]["Activation Bind"]
    if tbMode~="Always" and kc==Enum.KeyCode[tbKey] then
        if tbMode=="Toggle" then triggerEnabled=not triggerEnabled
        elseif tbMode=="Hold" then triggerEnabled=true end
    end
    if tbMode=="Always" then triggerEnabled=true end

    if kc==Enum.KeyCode[SpeedCfg["Keybind"]] then
        local hum=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        if hum then
            if not SpeedEnabled then BaseSpeed=16 SpeedEnabled=true
            else hum.WalkSpeed=16 SpeedEnabled=false end
        end
    end

    if kc==Enum.KeyCode[ESPCfg["Keybind"]] then
        espEnabled=not espEnabled
    end

    if kc==Enum.KeyCode[BTPCfg["Keybind"]] then
        btpEnabled=not btpEnabled
    end
end))

trackConnection(UserInputService.InputEnded:Connect(function(input,processed)
    if processed then return end
    local kc=input.KeyCode

    if kc==Enum.KeyCode[CameraCfg["Keybind"]] then
        if CameraCfg["Keybind Mode"]=="Hold" then
            isLocking=false currentTarget=nil lastVisibleTarget=nil targetLine.Visible=false
        end
    end

    if kc==Enum.KeyCode[SilentCfg["Keybind"]] then
        if SilentCfg["Keybind Mode"]=="Hold" then
            SilentCfg["Enabled"]=false
        end
    end

    local tbMode=TriggerCfg["Activation"]["Activation Mode"]
    local tbKey =TriggerCfg["Activation"]["Activation Bind"]
    if tbMode=="Hold" and kc==Enum.KeyCode[tbKey] then
        triggerEnabled=false
    end
end))

